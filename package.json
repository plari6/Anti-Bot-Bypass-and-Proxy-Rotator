{
  "name": "anti-bot-bypass-and-proxy-rotator",
  "version": "1.0.0",
  "description": "Node.js CLI and REST gateway that rotates datacenter, residential and mobile proxies, detects Cloudflare / DataDome / PerimeterX / Akamai blocks and escalates from fast HTTP to a stealth browser, so large data extraction jobs keep succeeding.",
  "type": "module",
  "bin": {
    "antibot": "bin/antibot.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node bin/antibot.js serve",
    "demo": "node bin/antibot.js demo",
    "doctor": "node bin/antibot.js doctor",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "keywords": [
    "proxy-rotator",
    "residential-proxies",
    "anti-bot",
    "cloudflare",
    "datadome",
    "web-scraping",
    "puppeteer-stealth",
    "axios",
    "data-extraction"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.21.1",
    "cheerio": "^1.2.0",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "puppeteer": "^25.17.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "socks-proxy-agent": "^10.1.0"
  },
  "allowScripts": {
    "puppeteer@25.17.0": true
  }
}
