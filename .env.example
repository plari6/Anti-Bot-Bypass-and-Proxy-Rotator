# ---- Proxies -------------------------------------------------------------
# A file (txt one per line, or JSON) and/or an inline list (comma or newline separated).
# Formats: http://user:pass@host:port | host:port | host:port:user:pass | socks5://host:port
# Tags after the URL: type=datacenter|residential|mobile|isp country=us cost=4.5 (USD per GB) id=name
# Rotating gateways: put {session} (and {country}) where your provider expects them, e.g.
#   http://customer-USER-session-{session}-cc-{country}:PASS@gate.provider.com:7000 type=residential cost=4
PROXY_FILE=proxies.txt
PROXIES=
PROXY_COUNTRY=

# ---- Escalation ladder ---------------------------------------------------
# Steps tried in order until a real page comes back. Steps without matching proxies are skipped.
LADDER=http:datacenter,http:residential,browser:residential,browser:mobile
ROTATION_STRATEGY=weighted          # weighted | round-robin | random | least-used
ALLOW_DIRECT=false                  # also try this machine's own IP first
RETRIES_PER_STEP=2
MAX_ATTEMPTS=8

# ---- Politeness and limits -----------------------------------------------
RESPECT_ROBOTS=true
DOMAIN_DELAY=1500ms                 # min gap between requests to the same site (jittered)
DOMAIN_CONCURRENCY=2
CONCURRENCY=4                       # parallel URLs in a job / gateway
BUDGET_USD=0                        # stop paid proxy traffic after this spend (0 = no limit)

# ---- Sessions and bans ----------------------------------------------------
SESSION_MAX_REQUESTS=60
SESSION_TTL=20m
BAN_COOLDOWN=2m                     # first per-site ban, doubles each strike
BAN_COOLDOWN_MAX=2h
DEAD_AFTER_ERRORS=5

# ---- Engines --------------------------------------------------------------
TIMEOUT=25s
BROWSER_TIMEOUT=45s
BROWSER_CONCURRENCY=2
BROWSER_BLOCK_ASSETS=true           # skip images/fonts/media = less paid bandwidth
HEADFUL=false
CHROME_PATH=
# CHROME_VERSION=157                # override the auto-estimated Chrome version in headers
DEBUG_DIR=                          # screenshots of failed browser pages

# ---- Gateway (antibot serve) ---------------------------------------------
PORT=8787
HOST=127.0.0.1
API_KEY=                            # required when HOST is not localhost

STATE_FILE=data/state.json
